  "claims": [
    {
      "id": "claim_7ffb40acfcf843d69feb2a08c376de13",
      "statement": "EmbeddingCreator.create(EmbeddingConfiguration, CacheManager) requires both arguments to be non-null (even for MOCK) and dispatches on the configuration's platform, instantiating OllamaEmbeddingCreator, OpenAiEmbeddingCreator, OnnxEmbeddingCreator, OpenWebUiEmbeddingCreator, or MockEmbeddingCreator; the four caching creators receive the CacheManager as a constructor argument rather than resolving CacheManager.getDefaultInstance() themselves, so cache settings come from the manager while model credentials come from the configuration's environment.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/embedding/EmbeddingCreator.java#L93-L105",
          "version": "repo-lines-v1:sha256:663e990f979a128236be63f27ed64455dd01c18c0ef2e10a85ee40693fbd81dc:"
