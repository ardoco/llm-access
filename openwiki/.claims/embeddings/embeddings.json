    },
    {
      "id": "claim_8aab757037ee473893e95a61cb9d8d15",
      "statement": "On any embed failure, CachedEmbeddingCreator.tryToFixWithLength first probes a cached fixed embedding under the key localKey + '_fixed_' + 8000, built through the deprecated EmbeddingCacheKey.ofRaw with the '(FIXED::8000): <content>' JSON content marker and read/written via the deprecated Cache.getViaInternalKey/putViaInternalKey methods — the sanctioned embedding use of the internal-key path kept for backwards compatibility with existing caches; a hit returns the truncated embedding without contacting the model.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/Cache.java#L36-L59",
          "version": "repo-lines-v1:sha256:cb40c7b9387f02f84951002c17811b115f79f278942080d8bdc4683d5a7528e7:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/embedding/EmbeddingCacheKey.java#L66-L79",
