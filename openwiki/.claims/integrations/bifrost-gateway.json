    {
      "id": "claim_fdc579910abf4bb8a92d7c620300db6a",
      "statement": "BifrostIntegrationTest is a live smoke test against a real gateway, gated by two @EnabledIfEnvironmentVariable conditions on both BIFROST_API_KEY and BIFROST_URL (each matching .+), so the whole class is silently disabled whenever either variable is unset; it makes one tiny chat request (openai/gpt-4o-mini, asserting a non-null non-blank answer) and one embedding request (openai/text-embedding-3-small against a LOCAL cache in a @TempDir, asserting a non-empty vector).",
      "evidence": [
        {
          "resource": "repo://src/test/java/edu/kit/kastel/mcse/ardoco/llm/BifrostIntegrationTest.java#L28-L64",
          "version": "repo-lines-v1:sha256:3449036a0ce41f40c49f7813e3edc8ba0b5924687b364544d8a2a3771c75ede4:"
        }
      ]
    },
    {
      "id": "claim_3ca024334db14f249bf41c1ff883c98a",
      "statement": "The dedicated GitHub Actions workflow .github/workflows/bifrost.yml runs BifrostIntegrationTest against a real gateway on pushes to main (ignoring v* tags) and PRs with paths-ignore for docs/** and openwiki/** plus manual dispatch, injects BIFROST_API_KEY and BIFROST_URL from repository secrets, and skips fork pull requests and Dependabot actors because those events receive no secrets; it runs only the smoke test via mvn -Dtest=BifrostIntegrationTest -Dsurefire.failIfNoSpecifiedTests=false and grants only contents: read.",
      "evidence": [
