  "claims": [
    {
      "id": "claim_48f37c09f9054b469879203694166366",
      "statement": "Both the chat and embedding subsystems resolve Bifrost's two required environment variables (BIFROST_API_KEY, BIFROST_URL) through the single shared util-layer helper edu.kit.kastel.mcse.ardoco.llm.util.Bifrost, making Bifrost the only platform whose credential-resolution code itself is shared across the two consumer subsystems rather than duplicated in each subsystem's factory.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/chat/ChatModelProvider.java#L261-L272",
          "version": "repo-lines-v1:sha256:35e735c6b74e3b9fb7f38112bd2fb8d9d3a14c31e48fed66b823cd296eb0b7e9:"
        },
