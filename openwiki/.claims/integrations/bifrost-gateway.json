    },
    {
      "id": "claim_4c6cc4d3f4da4de0a26948438af3463d",
      "statement": "Bifrost.headers(apiKey) returns the single-entry map with key x-bf-vk and the virtual key as value, and every Bifrost consumer sends the same virtual key twice: as the LangChain4j client's apiKey (bearer token) and as the x-bf-vk custom header, the header through which Bifrost accepts the virtual key in addition to the bearer token.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/chat/ChatModelProvider.java#L265-L269",
          "version": "repo-lines-v1:sha256:5a944d011d2d4f7e477a8a078545727346bf5e873b49057d239e666bc06b3eb4:"
