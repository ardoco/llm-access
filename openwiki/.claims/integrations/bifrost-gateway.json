    {
      "id": "claim_882ef331e0434a0fa8814f8ecbe3f8b1",
      "statement": "BifrostEmbeddingCreator is one of the two multi-threaded embedding creators (THREADS = 40, matching OpenAiEmbeddingCreator; the other caching creators run single-threaded) and implements only createEmbeddingModel, which builds an OpenAiEmbeddingModel at the gateway URL with the key as bearer token plus x-bf-vk header and an explicit 5-minute timeout, and sets no explicit maxRetries unlike OpenAiEmbeddingCreator's maxRetries(0).",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/embedding/BifrostEmbeddingCreator.java#L24-L57",
          "version": "repo-lines-v1:sha256:5a36a441bc865cbc88bda227e47e7b18e72f066062fe6c16392c87e1c07df2a8:"
