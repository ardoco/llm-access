    {
      "id": "claim_8425ec0717864231b6ff699582c95334",
      "statement": "ChatModelProvider.createBifrostChatModel resolves BIFROST_URL and BIFROST_API_KEY eagerly inside createChatModel() (so a missing variable aborts the factory call) and hands the resolved values to a LazyChatModel supplier that, on the first chat call, builds an OpenAiChatModel at BIFROST_URL with the configured model name, temperature, seed, the key as bearer token plus x-bf-vk header, and an explicit 10-minute timeout.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/chat/ChatModelProvider.java#L124-L272",
          "version": "repo-lines-v1:sha256:e486b0cdd0c4f62ce5ca318f6f944358617078766046cfacd8db0b2d5462647f:"
        },
        {
