          "version": "repo-lines-v1:sha256:f3f678fad887221c0452233806d91f31954a261ba8b62b550829ad87565d2b96:"
        }
      ]
    },
    {
      "id": "claim_f37bc3b0c41b4c2ea2a534b648e6c309",
      "statement": "Bifrost.baseUrl(environment) and Bifrost.apiKey(environment) resolve BIFROST_URL and BIFROST_API_KEY via EnvironmentProvider.getenvNonNull, which throws IllegalStateException when the variable is unset, so both Bifrost consumers fail fast against whatever EnvironmentProvider their configuration carries; there are no optional Bifrost environment variables.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/util/Bifrost.java#L34-L49",
          "version": "repo-lines-v1:sha256:65705c14024ef6839596ccc61c4ed65c99c112fbec8f4ae541d6f0f16aa1db05:"
