    {
      "id": "claim_c088e52f56e44997945be3133c594d03",
      "statement": "RedisCache connects via Jedis (adapted behind the UnifiedRedisClient abstraction) using REDIS_URL (default redis://localhost:6379) and fails fast: if PING fails at start-up it closes the client and throws IllegalStateException — there is no silent fallback, so a local fallback layer must be provided explicitly by pairing with LOCAL.",
      "evidence": [
        {
          "resource": "repo://README.md#L157-L159",
          "version": "repo-lines-v1:sha256:2f52a6f306fe5a2b278c8ad7ea26d2da4168c68c34ec85fbff3dcbe96582923e:"
