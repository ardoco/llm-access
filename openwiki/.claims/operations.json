    {
      "id": "claim_53df070cb9f54f529b006b0521a7510d",
      "statement": "Deploying the REDIS backend means running a Redis server reachable on its port (e.g. redis:7.4 with --appendonly yes so the cache survives restarts) and pointing clients at CACHE_HIERARCHY=REDIS,LOCAL with REDIS_URL; Redis has no authentication by default, so beyond a trusted network a password/TLS must be enabled with credentials in the URL (rediss://user:pass@host).",
      "evidence": [
        {
          "resource": "repo://README.md#L207-L235",
          "version": "repo-lines-v1:sha256:3092f6cc30ea456791c3c85193fcaba2d2f1903a07adb1b6145472e8c5cc3b5f:"
