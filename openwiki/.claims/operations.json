    {
      "id": "claim_dbf572716212405795b6e8104e331fbb",
      "statement": "REST-Redis serves HTTP-only egress: the client library talks HTTP to an optional reverse proxy that terminates TLS and Basic auth, the proxy forwards HTTP to the REST-Redis server (org.fuchss:rest-redis, Docker image ghcr.io/dfuchss/rest-redis), which proxies only the operations the cache uses (ping, exists, hget, hset) over TCP to Redis.",
      "evidence": [
        {
          "resource": "repo://README.md#L237-L249",
          "version": "repo-lines-v1:sha256:7c2a69ba7843e9762829082eb0ce55378796f864c9833d5a44a11342fd8ab0b3:"
