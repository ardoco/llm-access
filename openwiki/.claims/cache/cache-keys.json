    {
      "id": "claim_79c66cfaf63940b1945fc0b0fdba4db5",
      "statement": "KeyGenerator.generateKey normalizes CRLF to LF and returns a deterministic type-3 (name-based) UUID over the UTF-8 bytes of the normalized input, throwing IllegalArgumentException for null input; the concrete UUID value is pinned by KeyGeneratorTest.stableUuidValue (generateKey(\"test\") == 098f6bcd-4621-3373-8ade-4e832627b4f6) because it is part of the on-disk cache format and must stay stable across releases.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/util/KeyGenerator.java#L43-L50",
          "version": "repo-lines-v1:sha256:95f2220f3c12761b8caa6cb63cfbd14c5c8c92a41467b51d3c1ebfecdb6bc13d:"
