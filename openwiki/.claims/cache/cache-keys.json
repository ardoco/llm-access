          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/LocalCache.java#L106-L120",
          "version": "repo-lines-v1:sha256:9643859cfe5050a7f8dbcc771739f80062d0760850a14c4ee64e5f3d5fb04350:"
