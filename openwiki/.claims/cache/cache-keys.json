          "version": "repo-lines-v1:sha256:2d45be3f088bca3b3f963e06ee8e29a5cd80c97b6e48677c5cc5cd5a8737ee48:"
        }
      ]
    },
    {
      "id": "claim_5f43bcf0ff4d45bbadef6294663a6f9c",
      "statement": "LocalCache.putViaInternalKey addresses entries by cacheKey.localKey() and increments the dirty counter only when the stored value actually changes (old == null || !old.equals(jsonValue)), so re-putting identical content neither dirties the cache file nor advances the MAX_DIRTY = 50 auto-flush threshold; exceeding it triggers write(), which persists the in-memory map to disk via a temporary file.",
      "evidence": [
