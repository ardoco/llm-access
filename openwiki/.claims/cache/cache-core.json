    {
      "id": "claim_a4d19c84c0074a8d8a76ed2632b32661",
      "statement": "CacheKey.toJsonKey is a default method that serializes the whole key with the shared static MAPPER — a tools.jackson JsonMapper built with builderWithJackson2Defaults and SerializationFeature.INDENT_OUTPUT (Jackson 3) — throwing IllegalArgumentException on failure; concrete keys annotate localKey with @JsonIgnore from com.fasterxml jackson-annotations 2.x (field and getter), so the JSON key excludes it, and RedisCache uses this JSON string as the Redis hash key for hget/hset/exists.",
      "evidence": [
        {
          "resource": "repo://pom.xml#L58-L61",
          "version": "repo-lines-v1:sha256:57b0674318a1b115a977efacdc578263cfdb7dd78d19f6ad0f04e1f7774b7cc7:"
