        }
      ]
    },
    {
      "id": "claim_0e25b4b5611441b1b27db1a2a42b0579",
      "statement": "Cache.createByType(CacheType, CacheParameter<K>, @Nullable String cacheDir, @Nullable ObjectMapper mapper, EnvironmentProvider environment) dispatches per CacheType with validation: LOCAL requires a non-null cacheDir and builds LocalCache, REDIS and REST_REDIS require a non-null mapper and build RedisCache/RestRedisCache, forwarding the EnvironmentProvider so the backends read their connection settings (e.g. REDIS_URL); a missing required argument throws IllegalArgumentException.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/Cache.java#L121-L163",
          "version": "repo-lines-v1:sha256:de5835222f976ec030a8437c78103b109214178083cac63c5dcbd6116cbf75e1:"
