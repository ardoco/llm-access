    {
      "id": "claim_2ec1e522de1640dba436b5b0f4a6e031",
      "statement": "CacheManager.buildCacheHierarchy is the production caller of Cache.createByType: it creates one shared ObjectMapper and one cache-file path (<cacheDir>/<cacheName>.json) and instantiates every layer of the hierarchy with them; the Redis-based layers ignore the file path.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/CacheManager.java#L245-L259",
          "version": "repo-lines-v1:sha256:d1dc4ffd6ac2dc93b020322f2c73ff4686c1b58f27c72b58dd09abfe96dd8a9a:"
        }
      ]
    },
    {
      "id": "claim_a4d19c84c0074a8d8a76ed2632b32661",
      "statement": "CacheKey.toJsonKey is a default method that serializes the whole key with the shared static MAPPER (an ObjectMapper with SerializationFeature.INDENT_OUTPUT), throwing IllegalArgumentException on failure; concrete keys annotate localKey with @JsonIgnore (field and getter), so the JSON key excludes it, and RedisCache uses this JSON string as the Redis hash key for hget/hset/exists.",
