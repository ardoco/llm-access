        }
      ]
    },
    {
      "id": "claim_1f1f81f0444a4c9fab176fc7fdd2b64a",
      "statement": "CacheParameter<K extends CacheKey> defines what makes a cache unique: parameters() returns the unique configuration string that CacheManager composes into the LocalCache file name (<Origin>_<parameters>.json, colons sanitized to __), and createCacheKey(String content) is the single point where caller-facing content strings become cache keys.",
      "evidence": [
