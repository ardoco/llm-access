  "claims": [
    {
      "id": "claim_ee651f7e380e4b8bb4a7dc3a0a420759",
      "statement": "Cache<K extends CacheKey> is the storage contract shared by all backends: get(String, Class) deserializes and returns null when absent, put(String, String) / put(String, T) store values (the object variant serializes to JSON), plus containsKey, flush, and getCacheParameter; callers pass the content string and never handle CacheKey instances themselves.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/Cache.java#L18-L92",
          "version": "repo-lines-v1:sha256:1f45beed6cb9959862378429abf713a4ebabb73677d67c96ae84bbe1fc8f7e01:"
        }
      ]
    },
    {
      "id": "claim_4ba7cba4e1114c7f879e72213b3351f4",
      "statement": "Cache.convert is the deserialize helper every backend routes reads through: null input returns null, a failed deserialization of a String-typed value returns the raw string (backward compatibility for legacy unserialized cache entries), and any other failure throws IllegalArgumentException; LocalCache and RedisCache both call it in their get paths.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/Cache.java#L94-L119",
          "version": "repo-lines-v1:sha256:5e1d56dac59c87ff617f776faab126ad16fcf580773a57680b24de0856d74930:"
