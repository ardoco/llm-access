          "version": "repo-lines-v1:sha256:77313b49e3944d669d398000b2d925db97f3199532233ec89a2d07265e048c8e:"
        }
      ]
    },
    {
      "id": "claim_4b6475d34e9c4696acb04948cb56f3b0",
      "statement": "RedisCache.createRedisConnection reads REDIS_URL (unset or blank falls back to redis://localhost:6379), builds a RedisAdapter over redis.clients.jedis.RedisClient, and applies a fail-fast contract: if PING fails it closes the client and throws IllegalStateException (\"Could not connect to Redis. Make sure the container is up and running.\") with no silent fallback.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/RedisCache.java#L78-L91",
          "version": "repo-lines-v1:sha256:095f7d9fbbc80c76d2ce1c89f0ac4a747616c2a01e7353a2d77109a70dffa93c:"
        }
      ]
    },
    {
      "id": "claim_15e81677b7594f8bbcd760b72e5dd0f5",
      "statement": "RestRedisCache extends RedisCache and overrides only connection setup: it reads REST_REDIS_URI (unset or blank falls back to http://localhost:8080) plus optional REST_REDIS_USERNAME/REST_REDIS_PASSWORD, where blank values are treated as unset and the credentials are sent as HTTP Basic auth only when set, wrapping the org.fuchss:rest-redis Client in a RestRedisAdapter; all storage behavior is inherited from RedisCache.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/RestRedisCache.java#L16-L68",
          "version": "repo-lines-v1:sha256:4cd4ecbd8dae442d5306ed835f57a83a87cd2bcc53c3a3c03d2757ce13111867:"
        }
      ]
