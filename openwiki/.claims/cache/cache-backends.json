    {
      "id": "claim_ebd1d874faa748fab3c6b6e4bcba71e2",
      "statement": "RedisCache stores each entry as a Redis hash keyed by cacheKey.toJsonKey() with fields data (the JSON-serialized value) and timestamp (Instant.now().getEpochSecond()); the timestamp is written on every put but never read back, get reads only the data field, containsKey uses Redis EXISTS, and flush is a no-op because Redis persists immediately.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/RedisCache.java#L101-L128",
          "version": "repo-lines-v1:sha256:fcc834d8dea17ffaca2cc12df0f3a75f1137bf802aa3d12509783625fd44143f:"
        },
