    {
      "id": "claim_f2fc2b61020b490da9b745730f18c0b7",
      "statement": "CACHE_HIERARCHY is a comma-separated, case-insensitive list of cache types ordered primary first; in a layered hierarchy every put is write-through to all layers, every get consults all layers and backfills a value present in one layer into the layer that lacks it (in either direction), and under the default NONE conflict strategy the primary (first-listed) layer's value wins when two layers disagree.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/CacheManager.java#L271-L288",
          "version": "repo-lines-v1:sha256:002a238a316362601c93881069b4c16327ac8999c1cec259395f87e47b83884b:"
        },
        {
