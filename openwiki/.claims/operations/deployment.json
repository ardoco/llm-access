  "claims": [
    {
      "id": "claim_1ab7c570d759475992727836a5d6aa47",
      "statement": "RedisCache connects eagerly when the cache is constructed: it reads REDIS_URL from the manager's environment (unset or blank falls back to redis://localhost:6379) and pings through a Jedis-backed adapter. An unreachable server surfaces as the client's JedisConnectionException, and a server whose PING does not answer PONG causes the client to be closed and an IllegalStateException (\"Could not connect to Redis. Make sure the container is up and running.\") to be thrown — there is no silent fallback to another backend.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/RedisCache.java#L78-L91",
          "version": "repo-lines-v1:sha256:095f7d9fbbc80c76d2ce1c89f0ac4a747616c2a01e7353a2d77109a70dffa93c:"
        },
        {
          "resource": "repo://src/test/java/edu/kit/kastel/mcse/ardoco/llm/cache/CacheManagerTest.java#L131-L141",
          "version": "repo-lines-v1:sha256:63b1c7b71c131c743a173316446177be7da55e0ed69dbeb00b9bf0e055562338:"
        }
      ]
    },
    {
      "id": "claim_3ced32fd114b46ecbccb37a77b3fe40a",
      "statement": "RestRedisCache extends RedisCache and overrides only the connection setup (injected via RedisCache's protected constructor that accepts an already-connected UnifiedRedisClient); all storage behavior — Redis hashes keyed by the JSON form of the cache key with data and timestamp fields, and a no-op flush — is inherited, so both Redis transports store entries identically.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/RedisCache.java#L122-L128",
          "version": "repo-lines-v1:sha256:06221cc6010b9c5d512d41852ed7faf486158d748fea85fa49ad715c548cfffb:"
