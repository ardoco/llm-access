    {
      "id": "claim_350bc1b19ddd40508a067420d50d8139",
      "statement": "The OLLAMA branch requires OLLAMA_HOST and defers the authentication decision to the client supplier: when OLLAMA_USER and OLLAMA_PASSWORD are both non-empty it builds a native OllamaChatModel with a Basic Authorization header and a 10-minute timeout (basic auth takes precedence); otherwise, when OLLAMA_TOKEN is non-empty, it builds an OpenAI-compatible OpenAiChatModel at the Ollama host using the token as API key; otherwise it builds an unauthenticated OllamaChatModel with the 10-minute timeout.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/chat/ChatModelProvider.java#L163-L187",
          "version": "repo-lines-v1:sha256:2bb70c2a957e151bebefcc8def6a2e56a92638a335b11978c14d7eb7b6f478fb:"
        }
      ]
    },
