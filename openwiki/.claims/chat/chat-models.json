    {
      "id": "claim_30c930d21bbf43cfb0d692cdc41f528a",
      "statement": "LazyChatModel resolves its delegate with double-checked locking (a volatile delegate field plus a synchronized block) so the supplier runs at most once even under concurrent access, and a supplier that throws leaves the delegate null so the next chat call retries client construction.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/chat/LazyChatModel.java#L30-L53",
          "version": "repo-lines-v1:sha256:83dd7e7e2b68007b0abe7db0ab8015fd71509fd28ae19a10f18376bbdafb162c:"
        }
      ]
    },
    {
      "id": "claim_496e98ea1d2e4dc892d0565e83f1eb8f",
      "statement": "LazyChatModel forwards every ChatModel method — the chat and chatAsync families plus defaultRequestParameters, listeners, provider, and supportedCapabilities — to the lazily-resolved delegate so callers cannot distinguish it from the real client, and a reflection-based test asserts that all non-static ChatModel methods are overridden so no default method can bypass the delegation.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/chat/LazyChatModel.java#L55-L133",
          "version": "repo-lines-v1:sha256:7e7a6b768cc00dc43a89c0e019a1eeb774700aa5b9cede2448e770f2bff3afd1:"
        },
