    {
      "id": "claim_12bac1bba4854682b2b0ab8fd003365d",
      "statement": "Chat cache identity is ChatCacheParameter(modelName, seed, temperature) and every ChatCacheKey embeds model, seed, temperature, the CHAT mode, and the request content, so with a fixed seed and temperature identical requests are served from cache instead of being re-sent to the model (cost/latency reduction and reproducible runs); EmbeddingCacheKey pins seed and temperature to -1 and uses the EMBEDDING mode, so chat and embedding entries never collide and different models, seeds, and temperatures stay apart.",
      "evidence": [
        {
          "resource": "repo://README.md#L156-L163",
          "version": "repo-lines-v1:sha256:ac0f23759bb6decdeefcb7eea93744f2a7973e482e93aa2a210e992d23e203c5:"
