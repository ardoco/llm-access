    {
      "id": "claim_bf23446d81314d1083ee2afba138eb2e",
      "statement": "The chat and embedding subsystems build on the cache subsystem: ChatModelProvider exposes its settings as a ChatCacheParameter and CachingChatModel/ChatModelUtils operate on Cache<ChatCacheKey>, while every real embedding creator receives a CacheManager and stores into Cache<EmbeddingCacheKey>; the cache backends read connection settings from a util-layer EnvironmentProvider, and the util layer depends on no internal packages.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/cache/RedisCache.java#L78-L91",
          "version": "repo-lines-v1:sha256:095f7d9fbbc80c76d2ce1c89f0ac4a747616c2a01e7353a2d77109a70dffa93c:"
