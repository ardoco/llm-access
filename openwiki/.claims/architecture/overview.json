    {
      "id": "claim_f02cc53574754d31a3a63cd9f02fc8a2",
      "statement": "CachingChatModel implements caching once in doChat, the single point through which all ChatModel overloads are routed by the default interface methods: a cache hit returns the stored response without contacting the delegate; a miss delegates, caches the response text keyed by the string form of the messages, and flushes immediately so file-backed caches persist incrementally.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/llm/chat/CachingChatModel.java#L19-L64",
          "version": "repo-lines-v1:sha256:504ad0151a1d82dd7cba2657ad351cc758f46c7d996694fdf1bd0909b5e113d0:"
        }
      ]
    },
    {
      "id": "claim_b869c396933748f5a943708d36f3d334",
      "statement": "CachedEmbeddingCreator caches every embedding under a content-derived key, parallelizes batches with per-platform thread counts (OpenAI uses 40 threads; Ollama, ONNX, and Open WebUI use 1), and recovers from over-long inputs by jtokkit-driven binary-search truncation to MAX_TOKEN_LENGTH 8000 whose result is cached under a separate _fixed_ key.",
      "evidence": [
